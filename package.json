{
  "name": "codecolab",
  "displayName": "CodeColab — Live Code Collaboration",
  "publisher": "codecolab",
  "description": "Share the folder you already have open. No accounts: pick a name, generate a link, admit people one at a time, and code together.",
  "version": "2.6.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voritsack/code_colab_extention"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "collaboration",
    "pair programming",
    "teaching",
    "live share"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "CodeColab",
      "properties": {
        "codecolab.serverUrl": {
          "type": "string",
          "default": "https://code-colab.renode.space",
          "markdownDescription": "Backend origin. Defaults to the hosted CodeColab server; point it at `http://127.0.0.1:8000` to work against a local backend. Overridden by the `CODECOLAB_SERVER_URL` environment variable."
        },
        "codecolab.wsUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "WebSocket origin. Leave empty to derive it from `#codecolab.serverUrl#` (`http` → `ws`). Overridden by `CODECOLAB_WS_URL`."
        },
        "codecolab.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/.next/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/coverage/**",
            "**/.cache/**",
            "**/*.lock",
            "**/*.log",
            "**/.DS_Store",
            "**/.env",
            "**/.env.local",
            "**/.env.*.local",
            "**/.env.development",
            "**/.env.production",
            "**/.env.test",
            "**/.ssh/**",
            "**/.aws/**",
            "**/.gnupg/**",
            "**/id_rsa*",
            "**/id_ed25519*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/*.keystore",
            "**/*.jks",
            "**/.npmrc",
            "**/.pypirc",
            "**/.netrc",
            "**/credentials",
            "**/secrets.json",
            "**/secrets.yaml",
            "**/secrets.yml"
          ],
          "markdownDescription": "Glob patterns never shared or synchronised. The defaults cover generated output and, deliberately, credential files — sharing a folder should not hand over its `.env` or private keys. `.env.example` is still shared, since that is the point of it. Anything you add here applies to both directions."
        },
        "codecolab.maxFileBytes": {
          "type": "number",
          "default": 512000,
          "description": "Files larger than this are skipped. The server enforces its own limit as well."
        },
        "codecolab.maxFiles": {
          "type": "number",
          "default": 2000,
          "description": "Maximum number of files uploaded when a session starts."
        },
        "codecolab.syncDelayMs": {
          "type": "number",
          "default": 300,
          "description": "How long to wait after you stop typing before sending an edit."
        },
        "codecolab.autoOpenPanel": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the CodeColab view when a session starts."
        },
        "codecolab.autoUpdate": {
          "type": "string",
          "enum": [
            "silent",
            "ask",
            "off"
          ],
          "enumDescriptions": [
            "Download and install new versions in the background, then reload the window as soon as no session is running. Only ever from the configured server, and only over https (or localhost) — on a plain-http server this falls back to asking.",
            "Tell you a new version is available and let you decide.",
            "Never check."
          ],
          "default": "silent",
          "markdownDescription": "How to handle builds published by `#codecolab.serverUrl#`. `silent` installs them in the background and reloads the window once no session is running. Set this to `off` if you installed from the Marketplace — VS Code already keeps the extension current, and both updating at once means two sources installing over each other."
        },
        "codecolab.autoWriteSharedFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Write files shared with **Share this one** straight into your folder. The live sync only carries text under `#codecolab.maxFileBytes#`, so a binary or oversized file travels a different way; this decides whether it lands at its place in the folder or waits in the session's file list. Turn it off and nothing is written without you asking for it."
        }
      }
    },
    "commands": [
      {
        "command": "codecolab.startSession",
        "title": "Start session and generate link",
        "category": "CodeColab",
        "icon": "$(broadcast)"
      },
      {
        "command": "codecolab.joinSession",
        "title": "Join session by code or link",
        "category": "CodeColab",
        "icon": "$(sign-in)"
      },
      {
        "command": "codecolab.copyInvite",
        "title": "Copy invite link",
        "category": "CodeColab",
        "icon": "$(link)"
      },
      {
        "command": "codecolab.copyCode",
        "title": "Copy join code",
        "category": "CodeColab",
        "icon": "$(clippy)"
      },
      {
        "command": "codecolab.pauseSession",
        "title": "Pause session",
        "category": "CodeColab",
        "icon": "$(debug-pause)"
      },
      {
        "command": "codecolab.resumeSession",
        "title": "Resume session",
        "category": "CodeColab",
        "icon": "$(debug-continue)"
      },
      {
        "command": "codecolab.endSession",
        "title": "End session",
        "category": "CodeColab",
        "icon": "$(circle-slash)"
      },
      {
        "command": "codecolab.leaveSession",
        "title": "Leave session",
        "category": "CodeColab",
        "icon": "$(sign-out)"
      },
      {
        "command": "codecolab.reconnect",
        "title": "Reconnect to session",
        "category": "CodeColab",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "codecolab.resync",
        "title": "Resynchronise from host",
        "category": "CodeColab",
        "icon": "$(refresh)"
      },
      {
        "command": "codecolab.pushWorkspace",
        "title": "Push current workspace to everyone",
        "category": "CodeColab",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codecolab.showLog",
        "title": "Show log",
        "category": "CodeColab",
        "icon": "$(output)"
      },
      {
        "command": "codecolab.setName",
        "title": "Change your display name",
        "category": "CodeColab",
        "icon": "$(account)"
      },
      {
        "command": "codecolab.showPanel",
        "title": "Open the CodeColab panel",
        "category": "CodeColab",
        "icon": "$(window)"
      },
      {
        "command": "codecolab.checkForUpdates",
        "title": "Check for updates",
        "category": "CodeColab",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codecolab.rejoinSession",
        "title": "Rejoin the previous session",
        "category": "CodeColab",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codecolab.syncSharedFiles",
        "title": "Write shared files into the folder",
        "category": "CodeColab",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codecolab",
          "title": "CodeColab",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codecolab": [
        {
          "id": "codecolab.sessionView",
          "name": "Session",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codecolab.reconnect",
          "when": "view == codecolab.sessionView && codecolab.status == disconnected",
          "group": "navigation@0"
        },
        {
          "command": "codecolab.copyInvite",
          "when": "view == codecolab.sessionView && codecolab.isHost",
          "group": "navigation@1"
        },
        {
          "command": "codecolab.setName",
          "when": "view == codecolab.sessionView",
          "group": "overflow@1"
        },
        {
          "command": "codecolab.showLog",
          "when": "view == codecolab.sessionView",
          "group": "overflow@2"
        },
        {
          "command": "codecolab.checkForUpdates",
          "when": "view == codecolab.sessionView",
          "group": "overflow@3"
        }
      ],
      "commandPalette": [
        {
          "command": "codecolab.pauseSession",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.resumeSession",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.endSession",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.copyInvite",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.copyCode",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.pushWorkspace",
          "when": "codecolab.isHost"
        },
        {
          "command": "codecolab.leaveSession",
          "when": "codecolab.inSession"
        },
        {
          "command": "codecolab.resync",
          "when": "codecolab.inSession"
        },
        {
          "command": "codecolab.reconnect",
          "when": "codecolab.inSession"
        },
        {
          "command": "codecolab.syncSharedFiles",
          "when": "codecolab.inSession"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "package": "vsce package",
    "package:patch": "vsce package patch",
    "build-and-install": "npm run package:patch && powershell -Command \"code --install-extension (Get-ChildItem *.vsix | Sort-Object LastWriteTime -Descending | Select-Object -First 1).Name --force\"",
    "vscode:prepublish": "echo \"no build step\"",
    "test": "node test/run.js",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "eslint": "^8.57.0",
    "@vscode/vsce": "^3.2.0"
  },
  "icon": "media/logo.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#5B5BF0",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/voritsack/code_colab_extention/issues"
  },
  "qna": "marketplace",
  "homepage": "https://code-colab.renode.space"
}
