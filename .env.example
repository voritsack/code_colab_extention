# ---------------------------------------------------------------------------
# CodeColab VS Code extension.
#
# These are read from the environment of the VS Code process and take
# precedence over the "codecolab.*" settings. VS Code does not load this file
# itself - export the variables before launching `code`, or set the equivalent
# settings in the UI (search Settings for "CodeColab").
# ---------------------------------------------------------------------------

CODECOLAB_SERVER_URL=http://127.0.0.1:8000

# Leave empty to derive from CODECOLAB_SERVER_URL (http -> ws, https -> wss)
CODECOLAB_WS_URL=
