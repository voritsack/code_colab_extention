# ---------------------------------------------------------------------------
# VS Code extension configuration.
#
# The extension reads these from the process environment of the VS Code
# instance (they take precedence over the "blogapp.*" settings in settings.json).
# This file documents the names; VS Code does not auto-load it - either export
# the variables before launching `code`, or set the equivalent settings in the
# Settings UI (search for "BlogApp Code Sync").
# ---------------------------------------------------------------------------

BLOGAPP_SERVER_URL=http://127.0.0.1:8000

# Leave empty to derive from BLOGAPP_SERVER_URL (http -> ws, https -> wss)
BLOGAPP_WS_URL=
